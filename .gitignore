.venv/
__pycache__/
*.pyc
.pytest_cache/
# Service-account keys must never be committed
*.json.key
*service-account*.json
ee-key*.json
# Backfill rasters stay local (hundreds of MB); proof is the sha256 in logs/runs and re-downloadability
data/backfill/
# Archived first backfill (5-band, before checks C/D/F), kept locally for comparison
data/archive_v1/
# Web app working copy of the database (see webapp/main.py: never the published file)
.webapp/
# Local editor/app config (machine-specific paths)
.claude/
# Local scheduler: keys and settings, and its own log (run logs in logs/runs/ are still kept)
.env
logs/scheduler.log
# Generated sample database (rebuild with scripts/make_sample_db.py)
sample_data/*.db
# Extra SMBWI bands (B8A, B9, B11, B12), re-downloadable with scripts/download_smbwi_bands.py
data/smbwi_bands/
# Radar in linear power and cleaned radar, re-downloadable with scripts/clean_radar.py
data/s1_float/
data/s1_clean/
# Online dashboard, rebuilt by scripts/export_static_site.py
site/
# The live database lives on the data branch (see docs/DEPLOYMENT.md); the local copy is not tracked on main
sailab_glof.db
sailab_glof.resume.json
