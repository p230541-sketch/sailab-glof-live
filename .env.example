# Copy this file to ".env" and fill it in. Never commit .env (it is git-ignored).

# Earth Engine service-account key: the path to the key's .json file on this machine.
EE_SERVICE_ACCOUNT_KEY_FILE=C:\Users\you\keys\ee-key.json

# Or, instead of a file, the key's whole JSON text on one line:
# EE_SERVICE_ACCOUNT_KEY={"type": "service_account", "project_id": "...", ...}

# How often the scheduler wakes up and runs the pipeline (hours). Default 24.
# SAILAB_RUN_INTERVAL_HOURS=24

# How long it waits after a failed run before trying again (minutes). Default 30.
# SAILAB_RETRY_MINUTES=30
